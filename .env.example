# Copy to .env.local and fill in your values.

# ── Headless Checkout / Drop-in ──────────────────────────────────────────────
VITE_PURSE_API_KEY=your-api-key-here
VITE_PURSE_ENTITY_ID=your-entity-id-here

# Paste a full payment session JSON here for local testing.
# In production, replace getSession() in each recipe with your backend call.
VITE_PURSE_SESSION_JSON=

# ── Secure Fields ─────────────────────────────────────────────────────────────
VITE_PURSE_SECUREFIELDS_TENANT_ID=your-tenant-id-here
# VITE_PURSE_API_KEY is shared with Headless Checkout above.

# ── Advanced Flow (Payment API v2) ───────────────────────────────────────────
# Merchant backend that proxies the v2 endpoints (order, eligible_solutions,
# create_payment). These endpoints need a server-side bearer token and must not
# be called from the browser. In production, point this at your own backend.
VITE_PURSE_PROXY_URL=https://usp-widget-merchant.purse-sandbox.com

# ── Environment (optional, defaults to "sandbox") ────────────────────────────
# VITE_PURSE_ENVIRONMENT=sandbox

# ── Per-environment overrides ────────────────────────────────────────────────
# Vite loads .env.[mode] *after* .env.local, so a mode file wins over the shared
# defaults above — for that run only. Create these two next to this file
# (both are gitignored) and pass a mode:
#
#   .env.sandbox   npm run dev:react      # default, no mode needed
#   .env.test      npm run dev:react:test
#                  npm run dev:vanilla:test
#
# The 3DS fingerprint showcase (react/threeds.html) requires the test mode: the
# 3DS versioning + fingerprint chain exists only in the `test` Secure Fields
# build, and its tenant differs from the sandbox one.
#
# .env.test
#   VITE_PURSE_ENVIRONMENT=test
#   VITE_PURSE_SECUREFIELDS_TENANT_ID=<test tenant>
#   VITE_PURSE_ENTITY_ID=<test entity>
#   VITE_PURSE_API_KEY=<test api key>
#   VITE_PURSE_PROXY_URL=http://localhost:9001   # or the deployed test backend
#
# Do NOT put VITE_PURSE_ENVIRONMENT=test in .env.local: it applies to every
# mode, and the headless / drop-in demos have no `test` CDN entry.
